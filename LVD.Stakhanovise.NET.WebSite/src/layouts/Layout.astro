---
import '../styles/global.css';

const {
	title = 'Stakhanovise.NET',
	description = 'Distributed background job orchestration for .NET workers.'
} = Astro.props;

const navLinks = [
	{ href: '/', label: 'Overview' },
	{ href: '/docs', label: 'Docs' },
	{ href: '/presentations', label: 'Presentations' },
	{ href: 'https://github.com/alexboia/Stakhanovise.NET', label: 'GitHub', external: true }
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-[radial-gradient(circle_at_20%_20%,rgba(239,62,54,0.18),transparent_35%),radial-gradient(circle_at_80%_10%,rgba(244,190,62,0.2),transparent_30%),radial-gradient(circle_at_80%_70%,rgba(122,214,255,0.14),transparent_30%)] text-[var(--color-ink)] antialiased">
		<div class="fixed inset-0 -z-10 bg-[var(--color-bg)]"></div>
		<div class="pointer-events-none fixed inset-0 -z-10 grain opacity-40"></div>
		<div class="pointer-events-none fixed inset-x-0 top-0 -z-10 h-64 bg-gradient-to-r from-[rgba(239,62,54,0.3)] via-[rgba(244,190,62,0.25)] to-[rgba(122,214,255,0.22)] blur-3xl"></div>

		<header class="sticky top-0 z-20 border-b border-[var(--color-border)]/80 bg-black/30 backdrop-blur-xl">
			<div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 md:px-6">
				<a href="/" class="flex items-center gap-3">
					<div class="flex h-10 w-10 items-center justify-center rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] shadow-[0_0_0_1px_rgba(239,62,54,0.6)]">
						<span class="text-lg font-black text-[var(--color-accent)]">LVD</span>
					</div>
					<div>
						<p class="text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-muted)]">Stakhanovise.NET</p>
						<p class="text-sm text-[var(--color-ink)]/90">Industrial-grade worker queues</p>
					</div>
				</a>

				<nav class="flex items-center gap-2 text-sm md:gap-4">
					{navLinks.map((link) => (
						<a
							href={link.href}
							target={link.external ? '_blank' : undefined}
							rel={link.external ? 'noreferrer' : undefined}
							class="rounded-md px-3 py-2 font-medium uppercase tracking-[0.08em] text-[var(--color-muted)] transition hover:bg-[var(--color-border)]/60 hover:text-[var(--color-ink)]"
						>
							{link.label}
						</a>
					))}
				</nav>
			</div>
		</header>

		<main class="relative z-10 mx-auto flex max-w-6xl flex-col gap-12 px-4 py-12 md:px-6 md:py-16">
			<slot />
		</main>

		<footer class="border-t border-[var(--color-border)]/80 bg-black/40 py-8 backdrop-blur-xl">
			<div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 md:flex-row md:items-center md:justify-between md:px-6">
				<div>
					  <p class="text-lg tracking-[0.12em]" style="font-family: var(--font-display); color: var(--color-accent);">One queue to move them all.</p>
					<p class="text-sm text-[var(--color-muted)]">Resilient background job processing for hardworking services.</p>
				</div>
				<div class="flex gap-3">
					<a
						href="https://github.com/alexboia/Stakhanovise.NET"
						class="rounded-md border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-2 text-sm font-semibold uppercase tracking-[0.08em] text-[var(--color-ink)] transition hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
						target="_blank"
						rel="noreferrer"
					>
						View on GitHub
					</a>
					<a
						href="/docs"
						class="rounded-md bg-[var(--color-accent)] px-4 py-2 text-sm font-semibold uppercase tracking-[0.08em] text-black shadow-[0_10px_40px_rgba(239,62,54,0.35)] transition hover:translate-y-[-1px]"
					>
						Read the docs
					</a>
				</div>
			</div>
		</footer>
	</body>
</html>
