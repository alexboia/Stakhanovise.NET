---
import Layout from './Layout.astro';

interface Props {
  title: string;
  subtitle?: string;
  breadcrumbHref?: string;
}

const { title, subtitle, breadcrumbHref = '/docs' } = Astro.props as Props;
---

<Layout title={`${title} | Stakhanovise.NET`} description={subtitle ?? 'Documentation'}>
  <article class="markdown space-y-6 rounded-2xl border border-border bg-surface/80 p-6 shadow-[0_18px_50px_rgba(0,0,0,0.35)]">
    <header class="border-b border-border pb-4">
      <p class="text-xs uppercase tracking-[0.18em] text-muted">Stakhanovise.NET</p>
      <div class="mt-2 flex flex-wrap items-center gap-3">
        <h1 class="text-3xl font-black text-ink" style="font-family: var(--font-display);">{title}</h1>
        <a href={breadcrumbHref} class="rounded-md border border-border px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-muted transition hover:border-accent hover:text-accent">Back</a>
      </div>
      {subtitle && <p class="mt-2 text-sm text-muted">{subtitle}</p>}
    </header>
    <div class="space-y-4">
      <slot />
    </div>
  </article>
</Layout>
